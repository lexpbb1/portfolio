---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leadership" description="My leadership experience and philosophy">
  <div class="section-page">
    <h1>Leadership</h1>
    <p class="intro">Leadership experience and philosophy. Add your leadership content to the `content/leadership/` directory.</p>
    <p class="no-content">Leadership content coming soon. Add markdown files to the `content/leadership/` directory.</p>
  </div>
</BaseLayout>

<style>
  .section-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .section-page h1 {
    margin-bottom: 1rem;
    font-size: 2.5rem;
  }

  .intro {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .no-content {
    text-align: center;
    color: var(--text-tertiary);
    padding: 3rem 2rem;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px dashed var(--border);
  }

  @media (max-width: 768px) {
    .section-page {
      padding: 2rem 1rem;
    }

    .section-page h1 {
      font-size: 1.75rem;
    }
  }
</style>
