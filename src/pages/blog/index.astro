---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const authoredPosts = [
  { title: "The UK’s productivity puzzle and its implications for government policy", date: '14 July 2017', description: 'A firm-level account of weak UK productivity and the implications for capital allocation, competition, innovation and public policy.', url: 'https://economicsforthemillion.wordpress.com/2017/07/14/the-uks-productivity-puzzle-and-its-implications-for-government-policy/' },
  { title: 'Soft Brexit but a hard landing could create an economy that works for no-one', date: '7 February 2017', description: 'Why a smooth administrative exit could still expose deeper weaknesses in growth, productivity and living standards.', url: 'https://economicsforthemillion.wordpress.com/2017/02/07/soft-brexit-but-a-hard-landing-could-create-an-economy-that-works-for-no-one/' }
];
---

<BaseLayout title="Writing — Phil Ball" description="Original articles and current analytical writing by Phil Ball">
  <div class="listing-page">
    <span class="eyebrow">Writing</span><h1>Articles and essays</h1>
    <p class="intro">Current analytical writing and selected original articles from my earlier <em>Economics for the Million</em> archive. Reblogs and curated links are intentionally excluded.</p>
    <section><h2>Current work</h2><article class="item featured"><small>2026 · Rapid evidence assessment</small><h3><a href={`${base}projects/when-targeting-need-is-not-enough/`}>When targeting need is not enough</a></h3><p>How need, prevention, local capacity and marginal value can inform place-based allocation and responsible transition.</p></article></section>
    <section><h2>Original archive</h2>{authoredPosts.map(post => <article class="item"><small>{post.date}</small><h3><a href={post.url} target="_blank" rel="noreferrer">{post.title} ↗</a></h3><p>{post.description}</p></article>)}</section>
    <a class="archive" href="https://economicsforthemillion.wordpress.com/" target="_blank" rel="noreferrer">Visit the complete historical archive ↗</a>
  </div>
</BaseLayout>

<style>
  .listing-page{max-width:900px;margin:0 auto;padding:clamp(2.5rem,7vw,5rem) 1rem}.eyebrow,small{text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-size:.75rem;font-weight:800}.listing-page h1{font-size:clamp(2.7rem,7vw,5rem);letter-spacing:-.05em;margin:.5rem 0}.intro{font-size:1.15rem;line-height:1.7;color:var(--text-secondary);max-width:720px}.listing-page section{margin-top:3rem}.item{padding:1.4rem 0;border-top:1px solid var(--border)}.item.featured{padding:1.4rem;border:1px solid var(--border);border-radius:18px;background:var(--bg-secondary)}.item h3{margin:.35rem 0;font-size:1.45rem}.item h3 a{text-decoration:none}.item h3 a:hover{color:var(--accent)}.item p{color:var(--text-secondary);line-height:1.65}.archive{display:inline-block;margin-top:2rem;color:var(--accent);font-weight:750;text-decoration:none}
</style>
