---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
}

const content = Astro.props.frontmatter ?? Astro.props;
const { title, description, date, author } = content;
const parsedDate = date ? new Date(date) : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="content-article">
    <header class="article-header">
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
      <div class="article-meta">
        {parsedDate && <time datetime={parsedDate.toISOString()}>{parsedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
        {author && <span class="author">by {author}</span>}
      </div>
    </header>
    <div class="article-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .content-article {
    max-width: 65ch;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-header h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .article-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  .article-content {
    line-height: 1.8;
  }

  .article-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .article-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .article-content :global(p) {
    margin-bottom: 1rem;
  }

  .article-content :global(code) {
    background: var(--bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
  }

  .article-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .article-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }

  .article-content :global(th),
  .article-content :global(td) {
    min-width: 9rem;
    padding: 0.75rem;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--border);
  }

  .article-content :global(th) {
    background: var(--bg-secondary);
    font-weight: 700;
  }

  .article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0 1.5rem;
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .article-content :global(a:hover) {
    text-decoration: underline;
  }

  .article-content :global(details) {
    margin: 1rem 0;
    padding: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .article-content :global(details > summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding: 0.85rem 1rem;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .article-content :global(details > summary::-webkit-details-marker) {
    display: none;
  }

  .article-content :global(details > summary::after) {
    content: '+';
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  .article-content :global(details[open] > summary::after) {
    content: '−';
  }

  .article-content :global(details > :not(summary)) {
    margin-left: 1rem;
    margin-right: 1rem;
  }

  .article-content :global(details > h2:first-of-type),
  .article-content :global(details > h3:first-of-type) {
    margin-top: 0.75rem;
  }

  @media (max-width: 600px) {
    .content-article {
      padding: 1.5rem 1rem;
    }

    .article-header h1 {
      font-size: clamp(1.85rem, 9vw, 2.5rem);
      overflow-wrap: anywhere;
    }

    .description {
      font-size: 1rem;
    }

    .article-meta {
      flex-direction: column;
      gap: 0.25rem;
    }

    .article-content {
      line-height: 1.7;
    }

    .article-content :global(blockquote) {
      margin-left: 0;
      margin-right: 0;
      padding-left: 0.85rem;
    }
  }
</style>
